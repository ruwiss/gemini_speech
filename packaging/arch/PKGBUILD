# Maintainer: GeminiSpeechAPI contributors
# CachyOS / Arch: download this file next to the release tarball, then:
#   makepkg -si
pkgname=gemini-speech-api-bin
pkgver=1.0.8
pkgrel=1
pkgdesc="Tray dictation using Gemini 3.5 Transcribe Live"
arch=('x86_64')
url="https://github.com/ruwiss/gemini_speech"
license=('custom:unknown')
depends=('libxcb' 'libxkbcommon-x11' 'libgl' 'alsa-lib')
provides=('gemini-speech-api')
conflicts=('gemini-speech-api')
options=('!strip')
source=("GeminiSpeechAPI-linux.tar.gz::https://github.com/ruwiss/gemini_speech/releases/download/v${pkgver}/GeminiSpeechAPI-linux.tar.gz")
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/GeminiSpeechAPI"
  cp -a "$srcdir/GeminiSpeechAPI/." "$pkgdir/opt/GeminiSpeechAPI/"
  chmod +x "$pkgdir/opt/GeminiSpeechAPI/GeminiSpeechAPI"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/GeminiSpeechAPI/GeminiSpeechAPI "$pkgdir/usr/bin/gemini-speech-api"

  icon=/opt/GeminiSpeechAPI/assets/icon.png
  if [ ! -f "$srcdir/GeminiSpeechAPI/assets/icon.png" ] && [ -f "$srcdir/GeminiSpeechAPI/_internal/assets/icon.png" ]; then
    icon=/opt/GeminiSpeechAPI/_internal/assets/icon.png
  fi

  install -dm755 "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/gemini-speech-api.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=GeminiSpeechAPI
Comment=Tray dictation with Gemini
Exec=/opt/GeminiSpeechAPI/GeminiSpeechAPI
Icon=$icon
Terminal=false
Categories=Utility;AudioVideo;
StartupNotify=false
EOF
}
